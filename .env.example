# Optional. Paste these in Netlify → Site settings → Environment variables
# if you want every browser to sync without pasting the config into the app.
# Leave them blank to use the in-app Firebase box, or to run with no Firebase at all.
# Use the free Spark plan only. Do not enable billing.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
