# Optional overrides for the public Firebase web config built into the site.
# Leave them blank to use that config. Set them only to point at a different project.
# Use the free Spark plan only. Do not enable billing.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
