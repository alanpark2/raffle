rules_version = '2';
// Starlight Raffle. Free Spark plan only — no Cloud Functions, no billing.
// Any signed-in visitor who knows a room code can read and update that room.
// The room code is the privacy key. Use the long one the app generates.
service cloud.firestore {
  match /databases/{database}/documents {
    match /raffles/{roomId} {
      allow read: if signedIn() && goodRoom(roomId);
      allow create, update: if signedIn()
        && goodRoom(roomId)
        && request.resource.data.keys().hasOnly(['title', 'names', 'winners', 'out', 'demo', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 80
        && request.resource.data.names is list
        && request.resource.data.names.size() < 5000
        && request.resource.data.winners is list
        && request.resource.data.winners.size() < 5000
        && request.resource.data.out is list
        && request.resource.data.out.size() < 5000
        && request.resource.data.demo is bool
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }
  }

  function signedIn() {
    return request.auth != null;
  }

  function goodRoom(roomId) {
    return roomId.matches('^[a-z0-9-]{3,40}$');
  }
}
